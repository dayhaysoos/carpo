{
  "name": "carpo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "web",
    "review-contract",
    "review-service"
  ],
  "overrides": {
    "@hono/node-server": "2.1.0",
    "undici": "7.29.0",
    "wrangler": "$wrangler",
    "postcss": {
      "nanoid": "3.3.18"
    }
  },
  "scripts": {
    "dev": "npm run build:web && wrangler dev",
    "dev:web": "npm run dev -w web",
    "build:web": "npm run build -w web",
    "build": "npm run build:web && tsc --noEmit && npm run review:service:build",
    "deploy": "npm run build:web && wrangler deploy",
    "typecheck": "tsc --noEmit && npm run typecheck -w web && npm run review:contract:typecheck && npm run review:service:typecheck",
    "test": "npm run test:api && npm run test:web && npm run test:pr-review-publisher && npm run test:pr-review-runner && npm run review:contract:test && npm run test:pr-review-agent && npm run review:service:test",
    "test:api": "vitest run test",
    "test:web": "npm test --workspace web",
    "test:pr-browser": "node scripts/run-cloudflare-browser-review.mjs",
    "test:pr-review-publisher": "node --test scripts/publish-pr-review-evidence.test.mjs",
    "test:pr-review-runner": "node --test scripts/run-pr-review.test.mjs scripts/pr-review-agentic-execution.test.mjs scripts/run-durable-flue-review.test.mjs scripts/pr-review-lease.test.mjs scripts/pr-review-webmcp-fixture.test.mjs",
    "test:pr-review-agent": "node --test scripts/cloudflare-browser-session.test.mjs scripts/flue-pr-review-agent.test.mjs scripts/flue-pr-browser-review.test.mjs scripts/live-webmcp-verification-journey.test.mjs scripts/pr-browser-review-ui-contract.test.mjs",
    "review:pr-agent": "node scripts/run-cloudflare-flue-review.mjs",
    "review:contract:test": "npm run test -w review-contract",
    "review:contract:typecheck": "npm run typecheck -w review-contract",
    "review:service:dev": "npm run dev -w review-service",
    "review:service:build": "npm run build -w review-service",
    "review:service:deploy": "npm run deploy -w review-service",
    "review:service:typecheck": "npm run typecheck -w review-service",
    "review:service:test": "npm run test -w review-service",
    "review:pr": "node scripts/run-pr-review.mjs",
    "review:webmcp-fixture": "node scripts/pr-review-webmcp-fixture.mjs",
    "validate:pr-review-config": "node scripts/validate-pr-review-config.mjs",
    "test:encoder": "node --experimental-strip-types scripts/test-encoder-contract.ts",
    "test:helper": "python3 -m unittest discover helper",
    "test:perf": "python3 scripts/perf-test.py",
    "db:migrate:local": "wrangler d1 migrations apply carpo --local",
    "check:launch-access": "node scripts/check-launch-access.mjs",
    "test:launch-access": "node --test scripts/check-launch-access.test.mjs"
  },
  "dependencies": {
    "@carpo/review-contract": "0.1.0",
    "@cloudflare/containers": "^0.0.30",
    "@cloudflare/think": "^0.14.0",
    "@earendil-works/pi-ai": "^0.83.0",
    "@flue/runtime": "^2.0.3",
    "@flue/sdk": "^2.0.3",
    "@modelcontextprotocol/sdk": "1.30.0",
    "agents": "^0.20.1",
    "ai": "^6.0.241",
    "jose": "^6.2.10",
    "valibot": "^1.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.1",
    "@cloudflare/workers-types": "^5.20260804.1",
    "@types/node": "^22.15.17",
    "jsonc-parser": "^3.3.1",
    "playwright-core": "^1.62.1",
    "typescript": "^5.8.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.127.0"
  }
}
