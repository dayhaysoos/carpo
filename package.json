  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.2",
    "@cloudflare/workers-types": "^4.20250708.0",
    "@types/node": "^22.15.17",
    "typescript": "^5.8.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.37.0"
  }
