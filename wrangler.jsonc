{
  "name": "carpo",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI", "remote": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/artifacts/*", "/agents/*"]
  },
  "vars": {
    "MAX_CLIP_LENGTH_SECONDS": "60",
    "R2_PUBLIC_PREFIX": "/artifacts"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "carpo",
      "database_id": "c130b680-e7fc-489e-927f-3c2139bc0afb",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CLIPS_BUCKET",
      "bucket_name": "carpo-clips"
    }
  ],
  "containers": [
    {
      "class_name": "EncoderContainer",
      "image": "./container/Dockerfile",
      // ffmpeg is CPU-bound; standard-4 bills per active second only.
      "instance_type": "standard-4",
      "max_instances": 10
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ENCODER_CONTAINER",
        "class_name": "EncoderContainer"
      },
      {
        "name": "VideoClipAgent",
        "class_name": "VideoClipAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["EncoderContainer"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["VideoClipAgent"]
    }
  ]
}
