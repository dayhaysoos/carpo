{
  "name": "carpo-test",
  "main": "test/worker.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/artifacts/*", "/agents/*", "/share/*", "/auth/*"]
  },
  "vars": {
    "AUTH_MODE": "legacy",
    "R2_PUBLIC_PREFIX": "/artifacts",
    "WORKER_BASE_URL": "http://example.com",
    "HELPER_TOKEN": "test-helper-token",
    "HELPER_CLAIM_WINDOW_SECONDS": "0"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "carpo",
      "database_id": "00000000-0000-0000-0000-000000000002",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CLIPS_BUCKET",
      "bucket_name": "carpo-clips-test"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ENCODER_CONTAINER",
        "class_name": "EncoderContainer"
      },
      {
        "name": "VideoClipAgent",
        "class_name": "VideoClipAgent"
      },
      {
        "name": "TRANSCRIPT_PREPARATION",
        "class_name": "TranscriptPreparation"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["EncoderContainer"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["VideoClipAgent"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["TranscriptPreparation"]
    }
  ]
}
